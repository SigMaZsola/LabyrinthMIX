<UserControl x:Class="Labirintus.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyDown="Window_KeyDown"
             Focusable="True"
             Loaded="UserControl_Loaded"
             Height="450" Width="800">

    <UserControl.Resources>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0B4C8"/>
            <Setter Property="BorderBrush" Value="#2A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2A3A"/>
                                <Setter Property="BorderBrush" Value="#4A9EBF"/>
                                <Setter Property="Foreground" Value="#E0F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A1A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="BorderBrush" Value="#3A1A1A"/>
            <Setter Property="Foreground" Value="#C87070"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A0A0A"/>
                    <Setter Property="BorderBrush" Value="#BF4A4A"/>
                    <Setter Property="Foreground" Value="#FFB0B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#607080"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4A9EBF"/>
                                <Setter Property="Foreground" Value="#D0E8F8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#A0C4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="#0B1520">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FELÜL: MÓDVÁLASZTÓ TAB (CSAK UI, NINCS GAMEGRID DUPLIKÁCIÓ) -->
            <TabControl Grid.Row="0"
                        SelectionChanged="TabControl_SelectionChanged"
                        Background="Transparent"
                        BorderThickness="0">

                <TabItem Header="{DynamicResource EasyMode}"
                         Style="{StaticResource TabStyle}"/>

                <TabItem Header="{DynamicResource HardMode}"
                         Style="{StaticResource TabStyle}"/>
            </TabControl>

            <!-- JÁTÉKTÉR (EGY DB, EZ MARAD AZ EGYETLEN MAP) -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- MAP -->
                <Border Grid.Column="0"
                        Background="#0D1C2A"
                        BorderBrush="#1A2E42"
                        BorderThickness="0,1,1,0"
                        Margin="8,8,4,8"
                        CornerRadius="4">
                    <Grid x:Name="GameGrid"/>
                </Border>

                <!-- OLDALSÓ PANEL -->
                <Border Grid.Column="1"
                        Background="#0D1C2A"
                        BorderBrush="#1A2E42"
                        BorderThickness="1,1,0,0"
                        Margin="4,8,8,8"
                        CornerRadius="4">

                    <StackPanel Margin="8,8">

                        <TextBlock Text="{DynamicResource Dir}"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="#3A5A6A"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="txtLepesek"
                                   Text="—"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#4A9EBF"
                                   Height="105"/>

                        <TextBlock Text="{DynamicResource Chamber}"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="#3A5A6A"
                                   Margin="0,10,0,2"/>

                        <TextBlock x:Name="txtKincsestermek"
                                   Text="—"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#4A9EBF"
                                   Height="19"/>

                        <Button Style="{StaticResource NavButton}"
                                Margin="0,10,0,6"
                                Click="Button_Click"
                                Content="{DynamicResource Save}"/>

                        <Button Style="{StaticResource NavButton}"
                                Margin="0,0,0,6"
                                Click="Button_Click_1"
                                Content="🌐"/>

                        <Button Style="{StaticResource BackButton}"
                                Click="Back_Click"
                                Content="{DynamicResource Back}"/>

                    </StackPanel>

                </Border>

            </Grid>
        </Grid>

    </Border>
</UserControl>