<UserControl x:Class="Faszomat.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="450" Width="800">

    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0B4C8"/>
            <Setter Property="BorderBrush" Value="#2A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2A3A"/>
                                <Setter Property="BorderBrush" Value="#4A9EBF"/>
                                <Setter Property="Foreground" Value="#E0F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A1A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="BorderBrush" Value="#1A3A2A"/>
            <Setter Property="Foreground" Value="#70C887"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0A2A1A"/>
                    <Setter Property="BorderBrush" Value="#4ABF6A"/>
                    <Setter Property="Foreground" Value="#B0FFC0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#041A0E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7A9EB8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#0D1C2A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D1C2A"/>
                                <Setter Property="Foreground" Value="#C0DCEC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0A2030"/>
                                <Setter Property="Foreground" Value="#4A9EBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0B1520">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="◈  KINCSES LABIRINTUS  ◈"
                           FontFamily="Consolas"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#D0E8F8"
                           HorizontalAlignment="Center"
                           />
                <Border Height="1" Background="#1A2E42" Margin="0,10,0,0"/>
            </StackPanel>


            <Border Grid.Row="1"
                    BorderBrush="#1A2E42"
                    BorderThickness="0,1,0,1"
                    Background="#0D1C2A"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#2A3A4A"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#0A1520">
                        <TextBox x:Name="txtNameGiver"
                                 FontFamily="Consolas"
                                 FontSize="20"
                                 Foreground="#D0E8F8"
                                 CaretBrush="#4A9EBF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10,6"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                    <Button Grid.Column="2"
                            x:Name="btnOpen"
                            Content="ADD"
                            Style="{StaticResource ActionButton}"
                            Click="Add_Click" Margin="0,0,48,0"/>
                    <Button Grid.Column="2"
                            x:Name="btnLoad"
                            Content="LOAD"
                            Style="{StaticResource ActionButton}"
                            Click="Load_Click" Grid.ColumnSpan="3" Margin="110,0,114,0"/>

                    <Button Grid.Column="4"
                            x:Name="btnStart"
                            Content="START"
                            Style="{StaticResource StartButton}"
                            Click="Start_Click" Margin="45,0,0,0"/>
                </Grid>
            </Border>

            <!-- Saves list -->
            <Border Grid.Row="2"
                    Margin="16,12,16,16"
                    BorderBrush="#1A2E42"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#0D1C2A">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#0A1520"
                            BorderBrush="#1A2E42"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <TextBlock Text="MENTETT JÁTÉKOK"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#3A6A8A"
                                   />
                    </Border>

                    <ListBox Grid.Row="1"
                             x:Name="lbSaves"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>