<Window x:Class="MapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MapEditor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton x:Name="rbHu" Content="Hu" IsChecked="True"/>
                <RadioButton x:Name="rbEn" Content="En"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Szélesség: " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBox x:Name="txtWidth" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="20px"/>
                <TextBlock Grid.Row="1" Text="Magasság: " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBox x:Name="txtHeight" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="20px"/>
                <Button x:Name="btnGenerate" Content="Generálás" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="2px"/>
            </Grid>
            <TextBlock x:Name="txtCurrent" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="btnRoom" Grid.Row="3" Content="█" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="25px" MinWidth="25px"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="Szobák száma: "/>
                <TextBox x:Name="txtRoomNum" MinWidth="20px"/>
            </StackPanel>
        </Grid>
        <Button x:Name="btnSave" Grid.Row="2" Content="Mentés"/>
    </Grid>
</Window>
